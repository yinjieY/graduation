@startuml
skinparam defaultFontSize 13

title 溯源二维码管理流程图

start

:企业提交注册申请;

:系统创建待审核记录;

:管理员审核资质材料;

if (审核结果?) then (通过)
  :创建企业主数据记录;
  :推送审核通过通知;
else (拒绝)
  :记录拒绝原因;
  :推送审核拒绝通知;
  stop
endif

:企业创建生产批次(草稿);

:企业提交批次审核(待审核);

:管理员审核批次;

if (审核结果?) then (通过)
  :批次状态变为已通过;
else (拒绝)
  :企业修改后重新提交;
  stop
endif

:企业选择已通过审核的批次;

:构建qsId并拼接扫码URL;

:SM2私钥对核心数据签名;

:生成二维码PNG图片;

:触发区块链异步存证;

:消费者扫码;

:SM2公钥验签;

if (验签结果?) then (通过)
  if (二维码状态?) then (正常)
    :查询批次与企业信息;
    :返回溯源详情;
  else (冻结/注销)
    :返回风险提示;
  endif
else (失败)
  :返回签名验证失败提示;
endif

stop

@enduml
